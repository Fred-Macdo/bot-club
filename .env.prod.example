# Production Environment Variables
# Copy to .env and fill in all values before deploying
# Usage: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d

# === MongoDB ===
MONGO_USERNAME=botclub
MONGO_PASSWORD=CHANGE_ME_strong_password_here

# === Redis ===
REDIS_PASSWORD=CHANGE_ME_strong_password_here

# === Flower (Celery monitoring) ===
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_strong_password_here

# === Mongo Express (dev only — not used in prod) ===
# ME_ADMIN_USER=admin
# ME_ADMIN_PASSWORD=CHANGE_ME
